<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background">

    <LinearLayout
        android:id="@+id/keyboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="36dp">

        <Button
            android:id="@+id/vibeTypingButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:text="@string/vibe_typing"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/relationshipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/friendButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/friend"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/teammateButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/teammate"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/businessButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/business"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/professorButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/professor"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hangulRowTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button style="@style/VibeTypeHangulKey" android:tag="ㅂ" android:text="ㅂ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅈ" android:text="ㅈ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㄷ" android:text="ㄷ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㄱ" android:text="ㄱ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅅ" android:text="ㅅ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅛ" android:text="ㅛ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅕ" android:text="ㅕ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅑ" android:text="ㅑ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅐ" android:text="ㅐ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅔ" android:text="ㅔ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hangulRowMiddle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp">

            <Button style="@style/VibeTypeHangulKey" android:tag="ㅁ" android:text="ㅁ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㄴ" android:text="ㄴ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅇ" android:text="ㅇ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㄹ" android:text="ㄹ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅎ" android:text="ㅎ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅗ" android:text="ㅗ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅓ" android:text="ㅓ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅏ" android:text="ㅏ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅣ" android:text="ㅣ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hangulRowBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="42dp">

            <Button style="@style/VibeTypeHangulKey" android:tag="ㅋ" android:text="ㅋ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅌ" android:text="ㅌ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅊ" android:text="ㅊ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅍ" android:text="ㅍ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅠ" android:text="ㅠ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅜ" android:text="ㅜ" />
            <Button style="@style/VibeTypeHangulKey" android:tag="ㅡ" android:text="ㅡ" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/spaceButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/space" />

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/delete" />

            <Button
                android:id="@+id/enterButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/enter" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/suggestionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/suggestion_panel_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:translationY="24dp"
        android:visibility="gone">

        <Button
            android:id="@+id/suggestionAButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/suggestionBButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/suggestionCButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:textAllCaps="false"
            android:textColor="@color/black" />
    </LinearLayout>
</FrameLayout>
